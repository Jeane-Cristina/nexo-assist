{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "App do Nexo Assist: chat do funcionário, console do analista e o agent.",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
