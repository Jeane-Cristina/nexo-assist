# Porta HTTP do serviço de chamados
PORT=4000

# Token compartilhado entre o app web e este serviço (gere um valor aleatório)
SERVICE_TOKEN=troque-por-um-token-aleatorio

# Banco: arquivo SQLite local. No deploy, use a URL do Turso (libsql://...) + TICKETS_DB_AUTH_TOKEN
TICKETS_DB_URL=file:./data/tickets.db
TICKETS_DB_AUTH_TOKEN=

# Simulação do "sistema legado": chance de falha por requisição (0 a 1) e latência máxima em ms
LEGACY_FAILURE_RATE=0.1
LEGACY_MAX_LATENCY_MS=600
