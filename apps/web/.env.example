# --- LLM -------------------------------------------------------------------
# Modelo no formato "provedor/modelo" (roteador de modelos do Mastra).
# Trocar de provedor é só trocar esta linha e a chave correspondente.
# Flash-Lite: no plano gratuito tem 15 req/min e 500 req/dia (os Flash têm só 20 por dia,
# e cada mensagem do funcionário usa de 3 a 5 chamadas ao modelo).
LLM_MODEL=google/gemini-3.5-flash-lite
# Reserva: usado automaticamente se o principal estiver sobrecarregado ou sem cota (cota é por modelo).
LLM_FALLBACK_MODEL=google/gemini-3.1-flash-lite
# Chave do Google AI Studio (https://aistudio.google.com) — nunca commite.
GOOGLE_GENERATIVE_AI_API_KEY=
# Alternativas: ANTHROPIC_API_KEY=... com LLM_MODEL=anthropic/claude-haiku-5-5

# --- Serviço de chamados ----------------------------------------------------
TICKETS_SERVICE_URL=http://localhost:4000
# Mesmo valor de SERVICE_TOKEN em apps/tickets-service/.env
SERVICE_TOKEN=troque-por-um-token-aleatorio

# --- Banco do app (conversas, mensagens, presença dos analistas) ----------------------------
# Local: arquivo SQLite. Deploy: URL do Turso (libsql://...) + APP_DB_AUTH_TOKEN
APP_DB_URL=file:./data/app.db
APP_DB_AUTH_TOKEN=

# --- Login --------------------------------------------------------------------
# Chave que assina o cookie de sessão (32+ caracteres aleatórios)
SESSION_SECRET=troque-por-uma-chave-aleatoria-com-32-caracteres
# Senha de demonstração, igual para todos os usuários dos dados de exemplo
DEMO_PASSWORD=nexo123
