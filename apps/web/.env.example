# --- LLM -------------------------------------------------------------------
# Modelo no formato "provedor/modelo" (roteador de modelos do Mastra).
# Trocar de provedor é só trocar esta linha e a chave correspondente.
LLM_MODEL=google/gemini-2.5-flash
# Chave do Google AI Studio (https://aistudio.google.com) — nunca commite.
GOOGLE_GENERATIVE_AI_API_KEY=
# Alternativas: ANTHROPIC_API_KEY=... com LLM_MODEL=anthropic/claude-haiku-5-5

# --- Serviço de chamados ----------------------------------------------------
TICKETS_SERVICE_URL=http://localhost:4000
# Mesmo valor de SERVICE_TOKEN em apps/tickets-service/.env
SERVICE_TOKEN=troque-por-um-token-aleatorio

# --- Banco do app (conversas, mensagens, sessões) ----------------------------
# Local: arquivo SQLite. Deploy: URL do Turso (libsql://...) + APP_DB_AUTH_TOKEN
APP_DB_URL=file:./data/app.db
APP_DB_AUTH_TOKEN=
